class Mobile:
    def __init__(self, brand, price):
        self.brand = brand
        self.price = price

    def Mobile(self):
        print("Brand:", self.brand)
        print("Price:", self.price)


# Creating two objects
m1 = Mobile("Samsung", 25000)
m2 = Mobile("iPhone", 60000)

# Displaying attributes
m1.Mobile()
m2.Mobile()
      